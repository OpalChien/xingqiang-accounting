rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /accounts/xingqiang/customers/{customerId} {
      allow read, write: if true;
    }

    match /accounts/xingqiang/transactions/{transactionId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
